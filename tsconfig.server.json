{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist-server",
    "rootDir": "backend/src",
    "types": [
      "node"
    ]
  },
  "include": [
    "backend/src/**/*.ts"
  ]
}
